{
  "framework": null,
  "installCommand": "echo sem-install",
  "buildCommand": "mkdir -p dist && echo redirect > dist/index.html",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://www.portalpolowear.com.br/:path*",
      "permanent": true
    }
  ]
}
