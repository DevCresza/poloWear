{
  "framework": null,
  "installCommand": "echo sem-install",
  "buildCommand": "mkdir -p dist && echo ok > dist/robots.txt",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.portalpolowear.com.br/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://www.portalpolowear.com.br/$1",
      "permanent": true
    }
  ]
}
